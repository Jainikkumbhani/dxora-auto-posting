# Copy this file to .env and fill in your own values. NEVER commit .env.

# --- General ---------------------------------------------------------------
LOG_LEVEL=INFO
# Timezone for the "date" and "time" fields in each result.
APP_TIMEZONE=Asia/Kolkata
# Max seconds per platform (publish + public-access check).
PLATFORM_TIMEOUT_SECONDS=20
# Optional comma-separated subset. Empty = all platforms.
# Valid keys: bluesky, mastodon, telegram, github_gist, devto, discord
ENABLED_PLATFORMS=

# --- Bluesky ---------------------------------------------------------------
# Settings > Privacy and security > App passwords (do NOT use your main password)
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# --- Mastodon --------------------------------------------------------------
# Preferences > Development > New application, scope: write:statuses
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# --- Telegram --------------------------------------------------------------
# Bot token from @BotFather; add the bot as an admin of a PUBLIC channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_USERNAME=@your_public_channel

# --- GitHub Gist -----------------------------------------------------------
# Fine-grained personal access token with "Gists: Read and write".
GITHUB_TOKEN=

# --- DEV Community ---------------------------------------------------------
# https://dev.to/settings/extensions > DEV Community API Keys
DEVTO_API_KEY=

# --- Discord ---------------------------------------------------------------
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
